{
  "schema": "https://happyvertical.com/hv-agent-manifest/v1",
  "layer": "dotfiles",
  "priority": 10,
  "agent_docs": [
    {
      "id": "dotfiles.codex-defaults",
      "targets": ["agents", "codex"],
      "path": ".codex/AGENTS.md"
    }
  ],
  "skills": [
    {
      "agent": "codex",
      "name": "ship",
      "path": ".agents/skills/ship",
      "description": "Personal baseline shipping workflow"
    },
    {
      "agent": "codex",
      "name": "resolve",
      "path": ".agents/skills/resolve",
      "description": "Personal baseline review-comment resolution workflow"
    }
  ],
  "env_requirements": [
    {
      "capability": "identity",
      "vars": ["HV_AGENT_EMAIL"],
      "default_enabled": false,
      "description": "Per-user or per-agent HappyVertical account identity."
    }
  ],
  "services": []
}
